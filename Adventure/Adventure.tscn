[sub_resource type="GDScript" id="GDScript_g4tan"]
script/source = "extends Control





func _on_shop_pressed() -> void:
	get_tree().change_scene_to_file(\"res://Shop/Shop.tscn\")


func _on_equipment_pressed() -> void:
	get_tree().change_scene_to_file(\"res://Equipment/Equipment.tscn\")


func _on_event_pressed() -> void:
	get_tree().change_scene_to_file(\"res://Event/Event.tscn\")


func _on_achievement_pressed() -> void:
	get_tree().change_scene_to_file(\"res://Achievement/Achievement.tscn\")


func _on_start_pressed() -> void:
	get_tree().change_scene_to_file(\"res://Adventure/MapAdventure.tscn\")

func _ready():
	$TextureRect/Setting/SettingBoard.hide()
	$TextureRect/Setting.pressed.connect(_on_setting_pressed)



func _on_setting_pressed() -> void:
	$TextureRect/Setting/SettingBoard.show()


func _on_save_pressed() -> void:
	$TextureRect/Setting/SettingBoard.hide()
"

