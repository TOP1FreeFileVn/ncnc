[sub_resource type="GDScript" id="GDScript_7p54a"]
script/source = "extends Control



func _on_equipment_pressed() -> void:
	get_tree().change_scene_to_file(\"res://Equipment/Equipment.tscn\")

func _on_event_pressed() -> void:
	get_tree().change_scene_to_file(\"res://Event/Event.tscn\")


func _on_shop_pressed() -> void:
	get_tree().change_scene_to_file(\"res://Shop/Shop.tscn\")

func _on_adventure_pressed() -> void:
	get_tree().change_scene_to_file(\"res://Adventure/Adventure.tscn\")







func _ready():
	var list = $TextureRect/AchievementBoard/LishAchievement

	for mission_item in list.get_children():
		if mission_item.has_node(\"Button\"):
			var claim_btn = mission_item.get_node(\"Button\")

			# Gắn signal, truyền cả mission_item và claim_btn vào
			claim_btn.pressed.connect(_on_claim_pressed.bind(mission_item, claim_btn))


func _on_claim_pressed(mission_item, claim_btn):
	# Kiểm tra nếu nút bị disable (màu xám) thì không làm gì
	if claim_btn.disabled:
		print(\"Nút Nhận bị vô hiệu hóa, không làm gì.\")
		return
	
	# Xóa nhiệm vụ
	print(\"Xóa nhiệm vụ...\")
	var list = $TextureRect/AchievementBoard/LishAchievement
	list.remove_child(mission_item)
	mission_item.queue_free()
"

